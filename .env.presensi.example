# Tambahkan baris berikut ke file .env proyek Laravel 12 (lokal).
# Untuk server/hosting, pakai contoh lengkap di .env.production.example.
APP_LOCALE=id
SESSION_LIFETIME=720

# Aktifkan setelah HTTPS terpasang (lokal atau hosting).
FORCE_HTTPS=false
SECURITY_HSTS=false
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false

PRESENSI_TIMEZONE=Asia/Jakarta
PRESENSI_BATAS_TELAT=07:30
PRESENSI_JEDA_PULANG_MENIT=5
PRESENSI_NAMA_SEKOLAH="SMK Nu Ungaran"
# Bahasa tampilan. Bawaannya sudah "id", jadi baris ini opsional.
# PRESENSI_BAHASA=id

# Hari sekolah untuk perhitungan surat izin (1=Senin ... 7=Minggu).
# Sekolah dengan kelas hari Sabtu: PRESENSI_HARI_KERJA=1,2,3,4,5,6
PRESENSI_HARI_KERJA=1,2,3,4,5

# Opsional: akun admin awal untuk "php artisan db:seed"
ADMIN_EMAIL=admin@sekolah.test
ADMIN_PASSWORD=
