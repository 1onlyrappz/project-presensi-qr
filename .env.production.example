# ==========================================================================
# Contoh pengaturan .env untuk SERVER (produksi / hosting).
#
# Cara pakai:
#   1. Salin file ini menjadi .env di folder proyek Laravel Anda.
#   2. Isi APP_KEY, DB_*, dan ADMIN_* sesuai server.
#   3. Jangan menaruh file .env di dalam folder public/.
#
# Bagian yang wajib diubah ditandai "GANTI".
# ==========================================================================

APP_NAME="Presensi QR"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://presensi.sekolah.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
# Zona waktu aplikasi internal Laravel (timestamp database) tetap UTC.
# Jam presensi memakai PRESENSI_TIMEZONE di bawah.

# Log harian, cukup peringatan ke atas. Galat lengkap ada di storage/logs.
LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- HTTPS/SSL ---
# Setelah sertifikat terpasang dan bisa diakses lewat https://
FORCE_HTTPS=true
# Tambahkan header HSTS (hanya dikirim saat request HTTPS). Aktifkan
# setelah memastikan sertifikat valid di semua perangkat yang dipakai.
SECURITY_HSTS=true
# Jika dibelakang reverse proxy (Cloudflare/Nginx/Load balancer),
# isi IP proxy yang dipercaya, mis. 127.0.0.1,::1. Untuk cPanel biasa
# kosongkan saja.
TRUSTED_PROXIES=

# --- Database (biasanya sudah disediakan hosting) ---
# GANTI keempat nilai di bawah sesuai database dari cPanel.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=user_presensi
DB_USERNAME=user_presensi
DB_PASSWORD=kata_sandi_database

# --- Sesi ---
# SESSION_DRIVER=database memakai tabel "sessions" bawaan Laravel.
# Kalau tabel itu tidak ada, ganti ke file.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
# Wajib true kalau situs sudah HTTPS. Kalau masih http, set false.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Cache & antrean ---
# Laravel 12 memakai CACHE_STORE.
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Pengaturan aplikasi presensi ---
PRESENSI_TIMEZONE=Asia/Jakarta
PRESENSI_BATAS_TELAT=07:30
PRESENSI_JEDA_PULANG_MENIT=5
PRESENSI_NAMA_SEKOLAH="SMK Nu Ungaran"
# 1=Senin ... 7=Minggu. Tambahkan angka 6 kalau ada kelas hari Sabtu.
PRESENSI_HARI_KERJA=1,2,3,4,5

# --- Akun admin awal (hanya dipakai saat "php artisan db:seed") ---
# GANTI email di bawah. Kosongkan ADMIN_PASSWORD agar seeder membuat kata
# sandi acak dan menampilkannya sekali di layar (lebih aman daripada
# menulis kata sandi asli di file .env).
ADMIN_EMAIL=admin@smknuungaran.sch.id
ADMIN_PASSWORD=
