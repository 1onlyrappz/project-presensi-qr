APP_NAME="Presensi QR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database lokal (XAMPP/Laragon). Buat database bernama presensi_qr.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presensi_qr
DB_USERNAME=root
DB_PASSWORD=

# HTTPS/SSL
# FORCE_HTTPS=true setelah HTTPS aktif (lokal atau produksi).
FORCE_HTTPS=false
# HSTS hanya dikirim lewat HTTPS. Jangan aktifkan di lokal tanpa sertifikat terpercaya.
SECURITY_HSTS=false
# IP reverse proxy yang dipercaya (pisahkan koma), mis. 127.0.0.1,::1. Kosongkan kalau langsung.
TRUSTED_PROXIES=

# Sesi 12 jam. Kamera scan bisa dipakai sepanjang hari sekolah.
SESSION_DRIVER=file
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true hanya kalau situs sudah memakai HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sekolah.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Pengaturan aplikasi presensi ---
PRESENSI_TIMEZONE=Asia/Jakarta
PRESENSI_BATAS_TELAT=07:30
PRESENSI_JEDA_PULANG_MENIT=5
PRESENSI_NAMA_SEKOLAH="SMK Nu Ungaran"
PRESENSI_BAHASA=id
# 1=Senin ... 7=Minggu. Tambahkan angka 6 bila ada kelas hari Sabtu.
PRESENSI_HARI_KERJA=1,2,3,4,5

# Akun admin awal untuk "php artisan migrate --seed".
# Kosongkan ADMIN_PASSWORD agar seeder membuat sandi acak dan menampilkannya sekali.
ADMIN_EMAIL=admin@sekolah.test
ADMIN_PASSWORD=
